NODE_ENV="development"
SERVERPORT=3001
DBHOST="localhost"
DBPORT=3306
DBNAME="auto-abo-neu"
DBUSER=root
DBPASS=

APPURL=
SITEMAP_FRONTEND_BASE_URL=

JWT_SECRET=
ENCRYPTION_KEY=

HERE_API_KEY=
ANONYMIZE_ORDERS_ENABLED=true
ANONYMIZE_ORDERS_AFTER_DAYS=30
ANONYMIZE_ORDERS_INTERVAL_HOURS=24
EMAIL_LOG_PURGE_ENABLED=true
EMAIL_LOG_BODY_RETENTION_DAYS=90
FOLLOWUP_ENABLED=true
FOLLOWUP_SCHEDULER_INTERVAL_MS=60000
# Optional override; falls back to APPURL / SITEMAP_FRONTEND_BASE_URL
FOLLOWUP_CHECKOUT_BASE_URL=

OPENAI_API_KEY=

# Ladesäulen-Sync (MobiData BW / OCPDB)
CHARGING_SYNC_ENABLED=false
CHARGING_SYNC_EVSE_INTERVAL_MS=60000
CHARGING_SYNC_LOCATION_INTERVAL_MS=900000
# Stunde (UTC) für die nächtliche Erstladung
CHARGING_SYNC_FULL_HOUR_UTC=2
OCPDB_BASE_URL=https://api.mobidata-bw.de/ocpdb
OCPDB_LOCATIONS_PATH=/api/public/v1/locations
OCPDB_EVSES_PATH=/api/public/ocpi/3.0/evses
# max. 1000
OCPDB_PAGE_SIZE=1000
OCPDB_TIMEOUT_MS=30000
# mind. 1000 (höchstens ein Abruf pro Sekunde)
OCPDB_MIN_REQUEST_INTERVAL_MS=1000
# mit Kontaktadresse, z. B. "GrueneFlotte-Ladesaeulen-Sync/1.0 (+https://gruene-flotte.com; kontakt@...)"
OCPDB_USER_AGENT=
# Freiburg als WKT "POLYGON((lon lat, ...))". Im Polygon nur Betreiber mit
# Operators.freiburg_allowed = 1 (StromSpeicherMarkt, Wirelane); leer = keine Freiburg-Regel
CHARGING_FREIBURG_POLYGON_WKT=
# 1 = außerhalb Freiburgs alle Betreiber anzeigen (auch enbw_coverage "unknown")
CHARGING_SHOW_UNKNOWN=1
